<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>API Tester — ExpressJS01</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg: #0f0f17;
            --surface: #1a1a2e;
            --card: #16213e;
            --border: #2a2a4a;
            --accent: #7c3aed;
            --accent2: #06b6d4;
            --success: #10b981;
            --error: #ef4444;
            --warn: #f59e0b;
            --text: #e2e8f0;
            --muted: #64748b;
            --radius: 12px;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            padding: 2rem 1rem;
        }

        h1 {
            text-align: center;
            font-size: 2rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 0.4rem;
        }

        .subtitle {
            text-align: center;
            color: var(--muted);
            font-size: 0.9rem;
            margin-bottom: 2rem;
        }

        /* Token bar */
        #token-bar {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 1rem 1.25rem;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-wrap: wrap;
        }
        #token-bar .label { font-size: 0.8rem; color: var(--muted); white-space: nowrap; }
        #token-display {
            flex: 1;
            font-size: 0.78rem;
            font-family: monospace;
            color: var(--accent2);
            word-break: break-all;
            background: var(--card);
            border-radius: 6px;
            padding: 0.4rem 0.6rem;
            min-height: 36px;
        }
        #clear-token-btn {
            background: var(--error);
            color: white;
            border: none;
            border-radius: 6px;
            padding: 0.4rem 0.8rem;
            font-size: 0.78rem;
            cursor: pointer;
            transition: opacity .2s;
            white-space: nowrap;
        }
        #clear-token-btn:hover { opacity: 0.8; }

        /* Grid */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 1.25rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        /* Card */
        .card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            transition: border-color .2s;
        }
        .card:hover { border-color: var(--accent); }

        .card-header {
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }
        .method-badge {
            font-size: 0.7rem;
            font-weight: 700;
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
        }
        .POST { background: #7c3aed33; color: #a78bfa; }
        .GET  { background: #06b6d433; color: #67e8f9; }

        .card-title { font-weight: 600; font-size: 1rem; }
        .card-url   { font-size: 0.75rem; color: var(--muted); font-family: monospace; }

        /* Inputs */
        input {
            width: 100%;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text);
            padding: 0.6rem 0.8rem;
            font-size: 0.88rem;
            font-family: 'Inter', sans-serif;
            outline: none;
            transition: border-color .2s;
        }
        input:focus { border-color: var(--accent); }
        input::placeholder { color: var(--muted); }

        /* Button */
        button.send-btn {
            background: linear-gradient(135deg, var(--accent), #5b21b6);
            color: white;
            border: none;
            border-radius: 8px;
            padding: 0.65rem 1.2rem;
            font-size: 0.88rem;
            font-weight: 600;
            cursor: pointer;
            transition: opacity .2s, transform .1s;
        }
        button.send-btn:hover  { opacity: 0.88; }
        button.send-btn:active { transform: scale(0.98); }
        button.send-btn.cyan {
            background: linear-gradient(135deg, var(--accent2), #0284c7);
        }

        /* Response */
        .response-box {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 0.75rem;
            font-size: 0.8rem;
            font-family: monospace;
            white-space: pre-wrap;
            word-break: break-word;
            min-height: 60px;
            max-height: 200px;
            overflow-y: auto;
            color: var(--muted);
            transition: border-color .3s;
        }
        .response-box.ok    { border-color: var(--success); color: var(--success); }
        .response-box.err   { border-color: var(--error);   color: #fca5a5; }
        .response-box.warn  { border-color: var(--warn);    color: var(--warn); }
    </style>
</head>
<body>

<h1>🔐 API Tester</h1>
<p class="subtitle">ExpressJS01 — JWT Authentication Flow</p>

<!-- Token display bar -->
<div style="max-width:1200px;margin:0 auto 2rem;">
    <div id="token-bar">
        <span class="label">ACCESS TOKEN:</span>
        <div id="token-display">Chưa có token. Hãy đăng nhập để lấy token.</div>
        <button id="clear-token-btn" onclick="clearToken()">Xóa Token</button>
    </div>
</div>

<div class="grid">

    <!-- REGISTER -->
    <div class="card">
        <div class="card-header">
            <span class="method-badge POST">POST</span>
            <div>
                <div class="card-title">Đăng ký tài khoản</div>
                <div class="card-url">/v1/api/register</div>
            </div>
        </div>
        <input id="reg-name"  type="text"     placeholder="Họ tên">
        <input id="reg-email" type="email"    placeholder="Email">
        <input id="reg-pass"  type="password" placeholder="Mật khẩu">
        <button class="send-btn" onclick="register()">Gửi Request</button>
        <div class="response-box" id="res-register">Kết quả sẽ hiện ở đây...</div>
    </div>

    <!-- LOGIN -->
    <div class="card">
        <div class="card-header">
            <span class="method-badge POST">POST</span>
            <div>
                <div class="card-title">Đăng nhập</div>
                <div class="card-url">/v1/api/login</div>
            </div>
        </div>
        <input id="login-email" type="email"    placeholder="Email">
        <input id="login-pass"  type="password" placeholder="Mật khẩu">
        <button class="send-btn" onclick="login()">Đăng nhập & Lấy Token</button>
        <div class="response-box" id="res-login">Kết quả sẽ hiện ở đây...</div>
    </div>

    <!-- FORGOT PASSWORD -->
    <div class="card">
        <div class="card-header">
            <span class="method-badge POST">POST</span>
            <div>
                <div class="card-title">Quên mật khẩu</div>
                <div class="card-url">/v1/api/forgot-password</div>
            </div>
        </div>
        <input id="fp-email"    type="email"    placeholder="Email">
        <input id="fp-newpass"  type="password" placeholder="Mật khẩu mới">
        <button class="send-btn" onclick="forgotPassword()">Đổi mật khẩu</button>
        <div class="response-box" id="res-forgot">Kết quả sẽ hiện ở đây...</div>
    </div>

    <!-- GET USERS (protected) -->
    <div class="card">
        <div class="card-header">
            <span class="method-badge GET">GET</span>
            <div>
                <div class="card-title">Danh sách users 🔒</div>
                <div class="card-url">/v1/api/user</div>
            </div>
        </div>
        <p style="font-size:0.8rem;color:var(--muted)">Yêu cầu Access Token hợp lệ.</p>
        <button class="send-btn cyan" onclick="getUsers()">Lấy danh sách</button>
        <div class="response-box" id="res-users">Kết quả sẽ hiện ở đây...</div>
    </div>

    <!-- GET ACCOUNT (protected) -->
    <div class="card">
        <div class="card-header">
            <span class="method-badge GET">GET</span>
            <div>
                <div class="card-title">Thông tin tài khoản 🔒</div>
                <div class="card-url">/v1/api/account</div>
            </div>
        </div>
        <p style="font-size:0.8rem;color:var(--muted)">Yêu cầu Access Token hợp lệ.</p>
        <button class="send-btn cyan" onclick="getAccount()">Lấy thông tin</button>
        <div class="response-box" id="res-account">Kết quả sẽ hiện ở đây...</div>
    </div>

</div>

<script>
    // ─── Helpers ────────────────────────────────────────────
    const getToken = () => localStorage.getItem('access_token') || '';

    function setToken(token) {
        localStorage.setItem('access_token', token);
        document.getElementById('token-display').textContent = token;
    }

    function clearToken() {
        localStorage.removeItem('access_token');
        document.getElementById('token-display').textContent = 'Chưa có token. Hãy đăng nhập để lấy token.';
    }

    function showResult(boxId, data, isOk) {
        const box = document.getElementById(boxId);
        box.textContent = JSON.stringify(data, null, 2);
        box.className = 'response-box ' + (isOk ? 'ok' : 'err');
    }

    async function apiFetch(method, url, body, useToken) {
        const headers = { 'Content-Type': 'application/json' };
        if (useToken) {
            const t = getToken();
            if (!t) return { ok: false, data: { message: 'Bạn chưa có token! Hãy đăng nhập trước.' } };
            headers['Authorization'] = 'Bearer ' + t;
        }
        const opts = { method, headers };
        if (body) opts.body = JSON.stringify(body);
        const res = await fetch(url, opts);
        const data = await res.json();
        return { ok: res.ok, data };
    }

    // ─── Actions ────────────────────────────────────────────
    async function register() {
        const name     = document.getElementById('reg-name').value.trim();
        const email    = document.getElementById('reg-email').value.trim();
        const password = document.getElementById('reg-pass').value;
        const { ok, data } = await apiFetch('POST', '/v1/api/register', { name, email, password });
        showResult('res-register', data, ok && data.EC === 0);
    }

    async function login() {
        const email    = document.getElementById('login-email').value.trim();
        const password = document.getElementById('login-pass').value;
        const { ok, data } = await apiFetch('POST', '/v1/api/login', { email, password });
        if (ok && data.EC === 0 && data.access_token) {
            setToken(data.access_token);
        }
        showResult('res-login', data, ok && data.EC === 0);
    }

    async function forgotPassword() {
        const email       = document.getElementById('fp-email').value.trim();
        const newPassword = document.getElementById('fp-newpass').value;
        const { ok, data } = await apiFetch('POST', '/v1/api/forgot-password', { email, newPassword });
        showResult('res-forgot', data, ok && data.EC === 0);
    }

    async function getUsers() {
        const { ok, data } = await apiFetch('GET', '/v1/api/user', null, true);
        showResult('res-users', data, ok);
    }

    async function getAccount() {
        const { ok, data } = await apiFetch('GET', '/v1/api/account', null, true);
        showResult('res-account', data, ok);
    }

    // Restore token on load
    window.addEventListener('load', () => {
        const t = getToken();
        if (t) document.getElementById('token-display').textContent = t;
    });
</script>
</body>
</html>